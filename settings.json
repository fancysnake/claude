{
  "permissions": {
    "allow": [
      "Bash(mise run:*)"
    ],
    "deny": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(mypy:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(isort:*)",
      "Bash(pip:*)",
      "Bash(poetry:*)",
      "Bash(django-admin:*)",
      "Bash(./manage.py:*)",
      "Bash(manage.py:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(curl|sh)",
      "Bash(wget|sh)",
      "Bash(chmod 777:*)",
      "Bash(> /etc/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./mise.toml)",
      "Edit(./pyproject.toml)",
      "Edit(./.gitignore)",
      "Edit(./poetry.lock)",
      "Edit(./.claude/**)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
